# Messenger AI Bot Control Center - Environment Variables
NODE_ENV=development

# Server Port for API
PORT=4000

# Bot Worker Controls
DRY_RUN=true
TZ=Asia/Ho_Chi_Minh

# Database Path
DATABASE_PATH=./data/messenger_bot.db

# Playwright Persistent Profile Path
MESSENGER_USER_DATA_DIR=./.messenger-session

# Scheduler Defaults (Asia/Ho_Chi_Minh: 18:00 - 22:00, every 10 min)
DEFAULT_WINDOW_START=18:00
DEFAULT_WINDOW_END=22:00
DEFAULT_INTERVAL_MINUTES=10

# Rate Limiter Controls
MAX_MESSAGES_PER_HOUR=10
MIN_SECONDS_BETWEEN_MESSAGES=5
