# Messenger AI Bot Control Center - Environment Variables
NODE_ENV=development

# Server Port for API
PORT=4000

# Bot Worker Controls
DRY_RUN=true
TZ=Asia/Ho_Chi_Minh

# Database Path
DATABASE_PATH=./data/messenger_bot.db

# Playwright Persistent Profile Path
MESSENGER_USER_DATA_DIR=./.messenger-session

# Scheduler Defaults (Asia/Ho_Chi_Minh: 18:00 - 22:00, every 10 min)
DEFAULT_WINDOW_START=18:00
DEFAULT_WINDOW_END=22:00
DEFAULT_INTERVAL_MINUTES=10

# Rate Limiter Controls
MAX_MESSAGES_PER_HOUR=100
MIN_SECONDS_BETWEEN_MESSAGES=5

# Google Gemini AI Auto-Reply Configuration
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_QUOTA_REPLY_TEXT="Hiện tại AI đang tạm hết hạn mức (quota) xử lý hôm nay rồi ạ, lát nữa hoặc mai mình phản hồi lại nha! 😅"
