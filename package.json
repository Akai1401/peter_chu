{
  "name": "messenger-control-center",
  "version": "1.0.0",
  "private": true,
  "description": "Messenger AI Bot Control Center - Phase 1: Reminder Bot",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun --filter=@messenger/api run dev",
    "dev:worker": "bun --filter=@messenger/worker run dev",
    "dev:admin": "bun --filter=@messenger/admin run dev",
    "login:messenger": "tsx apps/worker/src/scripts/login.ts",
    "build": "bun run --workspaces build",
    "typecheck": "bun run --workspaces typecheck",
    "lint": "bun run --workspaces lint",
    "test": "bun run --workspaces test"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
